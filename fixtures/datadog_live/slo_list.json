      "description": "This SLO tracks the availability of the web service. Availability is measured as the number of successful requests divided by the number of total requests for the service",
      "id": "6ed07869fb2d5d0f9038bff3a8175996",
      "modified_at": 1770301217,
      "monitor_tags": [],
      "query": {
        "denominator": "sum:trace.flask.request.hits{env:sandbox,service:web,span.kind:server}.as_count()",
        "numerator": "sum:trace.flask.request.hits{env:sandbox,service:web,span.kind:server}.as_count() - sum:trace.flask.request.errors{env:sandbox,service:web,span.kind:server}.as_count()"
      },
      "sli_specification": {
        "count": {
          "good_events_formula": {
            "formula": "query1 - query2"
          },
          "queries": [
            {
              "data_source": "metrics",
              "name": "query1",
              "query": "sum:trace.flask.request.hits{env:sandbox,service:web,span.kind:server}.as_count()"
            },
            {
              "data_source": "metrics",
              "name": "query2",
              "query": "sum:trace.flask.request.errors{env:sandbox,service:web,span.kind:server}.as_count()"
            }
          ],
          "total_events_formula": {
            "formula": "query1"
          }
        }
      },
      "tags": [
        "env:sandbox",
        "service:web",
        "span.kind:server",
        "operation_name:flask.request"
      ],
      "target_threshold": 99.9,
