# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Ask your supervisor for these (see docs/datadog_api_catalog.md "Access checklist").

# Organization-level API key.
DD_API_KEY=

# Application key tied to your user — this is what carries read/write permissions.
DD_APP_KEY=

# Datadog site (the org's domain). CONFIRMED datadoghq.com (US) for observit-cluster1
# on 2026-06-23 via `slacheck doctor`. Other orgs: datadoghq.eu, us3/us5/ap1.datadoghq.com.
DD_SITE=datadoghq.com

# APM environment tag used by train-ticket (param of the service-dependencies endpoint).
# Often "prod" / "production" / "staging". For the slacheck instance: "slacheck".
DD_ENV=prod

# Kubernetes namespace for the kubernetes.* resource metrics (CPU/mem/restarts).
# May differ from DD_ENV (e.g. namespace tt-slacheck, APM env slacheck).
DD_K8S_NAMESPACE=tt-slacheck
