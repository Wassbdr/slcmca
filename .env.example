# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# See docs/datadog_api_catalog.md "Access checklist" for the required scopes.

# Organization-level API key.
DD_API_KEY=

# Application key tied to your user: this is what carries read/write permissions.
DD_APP_KEY=

# Datadog site (the org's domain). Verify with `slacheck doctor`.
# Common values: datadoghq.com (US), datadoghq.eu, us3/us5/ap1.datadoghq.com.
DD_SITE=datadoghq.com

# APM environment tag (param of the service-dependencies endpoint). Set to whatever env
# the trace collector uses (this is an environment tag, not an app name).
DD_ENV=your-env

# Kubernetes namespace for the kubernetes.* resource metrics (CPU/mem/restarts).
# The namespace your target app runs in (may differ from DD_ENV).
DD_K8S_NAMESPACE=your-namespace
